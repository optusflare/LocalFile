# Browser-visible config (NOT secrets). Copy to .env.local and fill in.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
VITE_TURNSTILE_SITE_KEY=
VITE_WORKER_URL=https://your-worker.your-subdomain.workers.dev
VITE_OWNER_UID=REPLACE_WITH_OWNER_UID
# Comma-separated STUN URLs. TURN is intentionally not configured (see README).
VITE_STUN_URLS=stun:stun.l.google.com:19302
